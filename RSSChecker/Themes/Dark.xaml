<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep Atmospheric Backdrop -->
    <SolidColorBrush x:Key="AppBg" Color="#070911"/>
    <SolidColorBrush x:Key="Surface" Color="#181C2C" Opacity="0.58"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#262C44" Opacity="0.62"/>
    <SolidColorBrush x:Key="GlassFill" Color="#FFFFFF" Opacity="0.065"/>
    <SolidColorBrush x:Key="GlassFillHover" Color="#FFFFFF" Opacity="0.11"/>
    <SolidColorBrush x:Key="GlassFillActive" Color="#FFFFFF" Opacity="0.15"/>
    <SolidColorBrush x:Key="Border" Color="#FFFFFF" Opacity="0.14"/>

    <!-- Liquid Glass Specular Rim & Sheen -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#58FFFFFF" Offset="0.0"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.45"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.75"/>
        <GradientStop Color="#2CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22FFFFFF" Offset="0.0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7B8CFF" Offset="0.0"/>
        <GradientStop Color="#56B4FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A7B0C8"/>

    <!-- Accents & Status -->
    <SolidColorBrush x:Key="Accent" Color="#6F9BFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#336F9BFF"/>
    <SolidColorBrush x:Key="Good" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Bad" Color="#FB7185"/>

</ResourceDictionary>
