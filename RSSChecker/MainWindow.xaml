<Window x:Class="RSSChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RSS"
        Icon="Assets/logo.ico"
        Height="780"
        Width="1180"
        MinHeight="640"
        MinWidth="920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="22"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="WindowOpenAnim">
            <DoubleAnimation Storyboard.TargetName="WindowFrame"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.96" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WindowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.96" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowOpenAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Outer Frameless Liquid Glass Shell -->
    <Border x:Name="WindowFrame"
            Margin="12"
            CornerRadius="22"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            ClipToBounds="True">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EE0A0D18" Offset="0.0"/>
                <GradientStop Color="#EB0F1426" Offset="0.5"/>
                <GradientStop Color="#EE090C16" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <!-- Ambient Aurora Orbs Behind Liquid Glass -->
            <Canvas IsHitTestVisible="False" Opacity="0.55">
                <Ellipse Width="520" Height="520" Canvas.Left="-120" Canvas.Top="-140">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#445C7CFA" Offset="0"/>
                            <GradientStop Color="#005C7CFA" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="560" Height="560" Canvas.Right="-140" Canvas.Bottom="-180">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3838BDF8" Offset="0"/>
                            <GradientStop Color="#0038BDF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="420" Height="420" Canvas.Left="360" Canvas.Top="180">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#22A855F7" Offset="0"/>
                            <GradientStop Color="#00A855F7" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Subtle Top Specular Glass Sheen -->
            <Border CornerRadius="21" Background="{DynamicResource GlassSheenBrush}" IsHitTestVisible="False"/>

            <!-- Falling Snow Layer -->
            <Canvas x:Name="SnowCanvas" IsHitTestVisible="False" Panel.ZIndex="100" ClipToBounds="True"/>

            <!-- Main App Layout -->
            <Grid Margin="22,14,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Frameless Top Bar (No White Bar!) -->
                <Grid Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Width="34" Height="34" CornerRadius="11"
                                Background="{DynamicResource GlassFill}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                Padding="5">
                            <Border.Effect>
                                <DropShadowEffect Color="#9D4EDD" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="RSS" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </StackPanel>

                    <!-- Centered Liquid Glass Navigation Pill -->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GlassFill}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NavScanBtn"
                                    Style="{StaticResource NavPillButton}"
                                    Content="Сканирование"
                                    Click="NavScan_Click"/>
                            <Button x:Name="NavResultsBtn"
                                    Style="{StaticResource NavPillButton}"
                                    Content="Результаты"
                                    Click="NavResults_Click"/>
                            <Button x:Name="NavHistoryBtn"
                                    Style="{StaticResource NavPillButton}"
                                    Content="История"
                                    Click="NavHistory_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Language Toggle + Windows 11 Caption Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="LangBtn"
                                Content="RU"
                                Click="Lang_Click"
                                Padding="11,5"
                                Margin="0,0,10,0"
                                FontSize="11"
                                FontWeight="SemiBold"/>
                        <Button Style="{StaticResource WinCaptionButton}"
                                Content="—"
                                Click="Minimize_Click"
                                ToolTip="Свернуть"/>
                        <Button x:Name="MaxBtn"
                                Style="{StaticResource WinCaptionButton}"
                                Content="□"
                                Click="Maximize_Click"
                                ToolTip="Развернуть"/>
                        <Button Style="{StaticResource WinCloseButton}"
                                Content="✕"
                                Click="Close_Click"
                                ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>

                <!-- Pages Container -->
                <Grid Grid.Row="1" Margin="0,14,0,0">

                    <!-- PAGE 1: SCAN (HOME) -->
                    <Grid x:Name="ScanPage">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ScanPageSlide" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Liquid Glass Card -->
                        <Border Background="{DynamicResource GlassFill}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="34,28"
                                Margin="0,0,0,16">
                            <Grid>
                                <Border CornerRadius="21" Background="{DynamicResource GlassSheenBrush}" IsHitTestVisible="False" Margin="-34,-28"/>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Status Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Border x:Name="StatusOrb"
                                                    Width="62" Height="62"
                                                    CornerRadius="20"
                                                    Background="{DynamicResource AccentSoft}"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="StatusOrbGlow" Color="#6F9BFF" BlurRadius="22" ShadowDepth="0" Opacity="0.4"/>
                                                </Border.Effect>
                                                <TextBlock x:Name="StatusIcon"
                                                           Text="🛡"
                                                           FontSize="26"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse x:Name="ScanRing"
                                                     Width="62" Height="62"
                                                     Stroke="{DynamicResource Accent}"
                                                     StrokeThickness="2.5"
                                                     StrokeDashArray="4 2.5"
                                                     Visibility="Collapsed"
                                                     RenderTransformOrigin="0.5,0.5"
                                                     IsHitTestVisible="False">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="ScanRingRotate" Angle="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <TextBlock x:Name="ProtectionText"
                                                       Text="Готово к проверке"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LastScanText"
                                                       Text="Выберите режим и нажмите кнопку ниже"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Bar Section -->
                                    <Border Grid.Row="1"
                                            Background="#14FFFFFF"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16,12"
                                            Margin="0,0,0,22">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="PhaseText"
                                                           Text="Ожидание запуска"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock x:Name="PercentText"
                                                           Text="0%"
                                                           DockPanel.Dock="Right"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </DockPanel>
                                            <ProgressBar x:Name="Progress"
                                                         Grid.Row="1"
                                                         Height="7"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Mode Selection Cards (Quick vs Full) -->
                                    <UniformGrid Grid.Row="2" Columns="2" Margin="-6,0,-6,22">
                                        <Border x:Name="QuickModeCard"
                                                Margin="6"
                                                Padding="18,16"
                                                CornerRadius="16"
                                                Background="{DynamicResource GlassFillActive}"
                                                BorderBrush="{DynamicResource Accent}"
                                                BorderThickness="1.5"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="SelectQuickMode_Click">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="QuickTitle" Text="⚡  Быстрая проверка" FontSize="15" FontWeight="SemiBold"/>
                                                    <Border x:Name="QuickBadge" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                            Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,3">
                                                        <TextBlock x:Name="QuickTimeText" Text="~15 сек" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock x:Name="QuickDesc"
                                                           Text="Проверяет активные программы, основные папки и автозагрузку."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="FullModeCard"
                                                Margin="6"
                                                Padding="18,16"
                                                CornerRadius="16"
                                                Background="{DynamicResource GlassFill}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="SelectFullMode_Click">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="FullTitle" Text="🔍  Полная проверка" FontSize="15" FontWeight="SemiBold"/>
                                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                            Background="#18FFFFFF" CornerRadius="8" Padding="8,3">
                                                        <TextBlock x:Name="FullTimeText" Text="~1–2 мин" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock x:Name="FullDesc"
                                                           Text="Глубокая проверка всех разделов, файлов и системных следов."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Big Action Button -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="ScanActionBtn"
                                                Style="{StaticResource PrimaryGlassButton}"
                                                Content="Начать проверку"
                                                MinWidth="210"
                                                Click="ScanAction_Click"/>
                                        <Button x:Name="ViewResultsBtn"
                                                Content="Открыть результаты"
                                                Visibility="Collapsed"
                                                Margin="12,4,0,4"
                                                Click="NavResults_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3 Simple Stat Cards -->
                        <UniformGrid Grid.Row="1" Columns="3" Margin="-6,0,-6,0">
                            <Border Background="{DynamicResource GlassFill}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20,16"
                                    Margin="6">
                                <StackPanel>
                                    <TextBlock x:Name="StatCheckedLabel" Text="ПРОВЕРЕНО" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="ObjectsValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="StatCheckedSub" Text="объектов в системе" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource GlassFill}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20,16"
                                    Margin="6">
                                <StackPanel>
                                    <TextBlock x:Name="StatConfirmedLabel" Text="НАЙДЕНО УГРОЗ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="ConfirmedValue" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Bad}" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="StatConfirmedSub" Text="подтверждённые совпадения" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource GlassFill}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20,16"
                                    Margin="6">
                                <StackPanel>
                                    <TextBlock x:Name="StatReviewLabel" Text="ТРЕБУЕТ ВНИМАНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="ReviewValue" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="StatReviewSub" Text="подозрительные объекты" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- PAGE 2: RESULTS -->
                    <Grid x:Name="ResultsPage" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ResultsPageSlide" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="4,0,4,16">
                            <StackPanel>
                                <TextBlock x:Name="ResultsTitle" Text="Результаты проверки" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ResultsSubtitle" Text="Нажмите на строку, чтобы посмотреть подробности." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="ExportHtmlBtn"
                                    Content="Сохранить отчёт"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ExportHtml_Click"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBox x:Name="SearchBox"
                                     Width="290"
                                     HorizontalAlignment="Left"
                                     TextChanged="Filters_Changed"/>
                            <ComboBox x:Name="StatusFilter"
                                      Width="185"
                                      Margin="10,0"
                                      SelectionChanged="Filters_Changed">
                                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                                <ComboBoxItem Content="Cheat Detected"/>
                                <ComboBoxItem Content="High Risk"/>
                                <ComboBoxItem Content="Suspicious"/>
                                <ComboBoxItem Content="Unverified"/>
                                <ComboBoxItem Content="Clean"/>
                            </ComboBox>
                            <TextBlock x:Name="ResultCount"
                                       Text="0 объектов"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="6,0,0,0"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource GlassFill}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="10">
                                <Grid>
                                    <DataGrid x:Name="ResultsGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserSortColumns="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="None"
                                              Background="Transparent"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderThickness="0"
                                              SelectionChanged="Finding_Selected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" SortMemberPath="StatusSortOrder" Width="125"/>
                                            <DataGridTextColumn Header="Риск" Binding="{Binding RiskScore, StringFormat={}{0}/100}" SortMemberPath="RiskScore" Width="72"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="165"/>
                                            <DataGridTextColumn Header="Подпись" Binding="{Binding Signature}" Width="175"/>
                                            <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ResultsEmpty"
                                               Text="Пока нет результатов. Запустите проверку на главном экране."
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="30"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Slide-in Liquid Glass Detail Drawer -->
                            <Border Grid.Column="1"
                                    x:Name="DetailPanel"
                                    Background="{DynamicResource GlassFill}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="20"
                                    Margin="12,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="DetailHeader" Text="Подробности" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/>
                                            <Button Content="✕" Click="CloseDetails_Click" DockPanel.Dock="Right" Padding="10,4" Margin="0"/>
                                        </DockPanel>
                                        <TextBlock x:Name="DetailName" Text="Выберите объект" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,4"/>
                                        <TextBlock x:Name="DetailStatus" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DetailCategory" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,14"/>

                                        <TextBlock x:Name="DetailPathLabel" Text="ПУТЬ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="DetailPath" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                        <TextBlock Text="ЦИФРОВАЯ ПОДПИСЬ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="DetailSignature" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                        <TextBlock Text="SHA-256" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="DetailHash" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,12"/>

                                        <TextBlock x:Name="DetailReasonLabel" Text="ПРИЧИНА ОБНАРУЖЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="DetailReason" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                        <TextBlock Text="ДАТА ОБНАРУЖЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="DetailDate" Margin="0,4,0,14"/>

                                        <TextBlock Text="НАЙДЕННЫЕ СВИДЕТЕЛЬСТВА" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="DetailEvidencesList" Margin="0,0,0,16">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,8" Margin="0,3">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SourceType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button x:Name="OpenFolderBtn"
                                                Content="Открыть в проводнике"
                                                Click="OpenFolder_Click"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- PAGE 3: HISTORY -->
                    <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="HistoryPageSlide" Y="0"/>
                        </ScrollViewer.RenderTransform>
                        <StackPanel Margin="4,0,4,10">
                            <TextBlock x:Name="HistoryTitle" Text="История проверок" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistorySubtitle" Text="Недавние проверки на этом устройстве." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassFill}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="18,14"
                                                Margin="0,5">
                                            <DockPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Mode}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding StartedAt, StringFormat={}{0:g}}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="#18FFFFFF"
                                                        CornerRadius="10"
                                                        Padding="12,6">
                                                    <TextBlock Text="{Binding Findings.Count, StringFormat={}{0} совп.}" FontWeight="Medium"/>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HistoryEmpty"
                                       Text="Пока нет сохранённых проверок."
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,12"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
